{
  "name": "agent-runbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p sidecar/tsconfig.json --noEmit",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "sidecar:build:all": "node scripts/build-sidecar.mjs --all",
    "sidecar:dev": "bun run sidecar/src/index.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "predev": "node scripts/build-sidecar.mjs",
    "prebuild": "node scripts/build-sidecar.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.0.1",
    "@earendil-works/pi-ai": "^1.0.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
